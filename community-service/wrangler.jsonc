{
  "name": "tar-client-community",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": { "VERIFIER_URL": "https://tar-client-verifier.netlify.app/.netlify/functions/mojang" },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY", "class_name": "Community" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Community"] }],
  "observability": { "enabled": false }
}
